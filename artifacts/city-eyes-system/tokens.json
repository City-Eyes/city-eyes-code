{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to `H S% L%` channels for the web theme and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#f4f0e6" },
      "foreground": { "$value": "#263b32" },
      "border": { "$value": "#d8d2c3" },
      "card": { "$value": "#fffcf4" },
      "cardForeground": { "$value": "#263b32" },
      "popover": { "$value": "#fffcf4" },
      "popoverForeground": { "$value": "#263b32" },
      "primary": {
        "$value": "#315c45",
        "$description": "Primary brand color. Drives buttons, links, and emphasis."
      },
      "primaryForeground": { "$value": "#fffcf4" },
      "secondary": { "$value": "#e3e9dc" },
      "secondaryForeground": { "$value": "#263b32" },
      "muted": { "$value": "#e9e2d2" },
      "mutedForeground": { "$value": "#536457", "$description": "Slightly darkened from the source muted tone to meet WCAG AA on muted surfaces." },
      "accent": { "$value": "#a85032" },
      "accentForeground": { "$value": "#fffcf4" },
      "destructive": { "$value": "#963f35" },
      "destructiveForeground": { "$value": "#fffcf4" },
      "input": { "$value": "#d8d2c3" },
      "ring": { "$value": "#a85032" },
      "chart1": { "$value": "#315c45" },
      "chart2": { "$value": "#a85032" },
      "chart3": { "$value": "#80521f" },
      "chart4": { "$value": "#35694e" },
      "chart5": { "$value": "#963f35" },
      "sidebar": { "$value": "#e9e2d2" },
      "sidebarForeground": { "$value": "#263b32" },
      "sidebarBorder": { "$value": "#d8d2c3" },
      "sidebarPrimary": { "$value": "#315c45" },
      "sidebarPrimaryForeground": { "$value": "#fffcf4" },
      "sidebarAccent": { "$value": "#e3e9dc" },
      "sidebarAccentForeground": { "$value": "#263b32" },
      "sidebarRing": { "$value": "#a85032" }
    },
    "dark": {
      "background": { "$value": "#1e2b25" },
      "foreground": { "$value": "#f1ecdc" },
      "border": { "$value": "#48574a" },
      "card": { "$value": "#29382f" },
      "cardForeground": { "$value": "#f1ecdc" },
      "popover": { "$value": "#29382f" },
      "popoverForeground": { "$value": "#f1ecdc" },
      "primary": { "$value": "#b8d0ae" },
      "primaryForeground": { "$value": "#1e2b25" },
      "secondary": { "$value": "#39453a" },
      "secondaryForeground": { "$value": "#f1ecdc" },
      "muted": { "$value": "#39453a" },
      "mutedForeground": { "$value": "#bdc5b5" },
      "accent": { "$value": "#edaa83" },
      "accentForeground": { "$value": "#1e2b25" },
      "destructive": { "$value": "#f0a79a" },
      "destructiveForeground": { "$value": "#1e2b25" },
      "input": { "$value": "#48574a" },
      "ring": { "$value": "#f1b393" },
      "chart1": { "$value": "#b8d0ae" },
      "chart2": { "$value": "#edaa83" },
      "chart3": { "$value": "#edc58c" },
      "chart4": { "$value": "#abd0a9" },
      "chart5": { "$value": "#f0a79a" },
      "sidebar": { "$value": "#29382f" },
      "sidebarForeground": { "$value": "#f1ecdc" },
      "sidebarBorder": { "$value": "#48574a" },
      "sidebarPrimary": { "$value": "#b8d0ae" },
      "sidebarPrimaryForeground": { "$value": "#1e2b25" },
      "sidebarAccent": { "$value": "#39453a" },
      "sidebarAccentForeground": { "$value": "#f1ecdc" },
      "sidebarRing": { "$value": "#f1b393" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Nunito Sans", "system-ui", "sans-serif"],
        "$description": "Portable cross-platform equivalent chosen for the Avenir Next visual reference; bundle the font in Expo."
      },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono": { "$value": ["SFMono-Regular", "Consolas", "Liberation Mono", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.875rem",
      "$description": "Base corner radius; sm/md/lg/xl derive from this in the theme."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
