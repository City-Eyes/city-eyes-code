# Porta 5001 recomendada no macOS (a porta 5000 costuma ser usada pelo AirPlay Receiver)
PORT=5001
NODE_ENV=development

# PostgreSQL local (ex.: container Docker postgres:16 na porta 5433)
DATABASE_URL=postgresql://cityeyes:cityeyes_dev_secret@localhost:5433/city_eyes_dev
DATABASE_TEST_URL=postgresql://cityeyes:cityeyes_dev_secret@localhost:5433/city_eyes_test

# Diretório local para simular storage privado fora do Replit
PRIVATE_OBJECT_DIR=/tmp/city-eyes-private-storage

# OIDC / Replit placeholders para ambiente local
ISSUER_URL=https://replit.com/oidc
REPL_ID=dev-local-repl-id

# Variáveis públicas do cliente mobile (Expo)
EXPO_PUBLIC_DOMAIN=localhost:5001
EXPO_PUBLIC_REPL_ID=dev-local-repl-id
